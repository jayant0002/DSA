class Solution {
    public List<List<Integer>> levelOrder(TreeNode root) {
        List<List<Integer>> res = new ArrayList<>();
        if(root==null) return res;
        Queue<TreeNode> q = new ArrayDeque<>();
        q.offer(root);
        while(!q.isEmpty()){
            int n= q.size();
            List<Integer> lvl = new ArrayList<>();
            while(n!=0){
        TreeNode curr = q.poll();
        lvl.add(curr.val);
        if(curr.left!=null){
            q.offer(curr.left);
        }
        if(curr.right!=null){
            q.offer(curr.right);
        }
        n--;
        }
        res.add(lvl);
    }
    return res;
    }
}
